<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="SiteMaster" %>
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> - Hotel Aurora</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="Content/Site.css" rel="stylesheet" />
</head>
<body>
<form id="form1" runat="server">
    <!-- Overlay oscuro para cerrar el menú en móvil -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="cerrarMenu()"></div>

    <div class="app">
        <!-- ===== Barra lateral ===== -->
        <aside class="sidebar" id="sidebar">
            <div class="brand">
                <div class="brand-mark">A</div>
                <div>
                    <div class="brand-name">Hotel Aurora</div>
                    <div class="brand-sub">Sistema de reservas</div>
                </div>
            </div>
            <ul class="side-nav">
                <li><a class="<%= Act("Default.aspx") %>"     href="Default.aspx"><i class="bi bi-grid-1x2"></i>Inicio</a></li>
                <li><a class="<%= Act("Reservas.aspx") %>"    href="Reservas.aspx"><i class="bi bi-calendar2-check"></i>Reservas</a></li>
                <li><a class="<%= Act("Huespedes.aspx") %>"   href="Huespedes.aspx"><i class="bi bi-people"></i>Huéspedes</a></li>
                <li><a class="<%= Act("Habitaciones.aspx") %>" href="Habitaciones.aspx"><i class="bi bi-key"></i>Habitaciones</a></li>
                <li><a class="<%= Act("Reportes.aspx") %>"    href="Reportes.aspx"><i class="bi bi-bar-chart-line"></i>Reportes</a></li>
            </ul>
            <div class="side-foot">Proyecto final · Scrum&nbsp;+ XP<br />Hotel Aurora &copy; 2026</div>
        </aside>

        <!-- ===== Área principal ===== -->
        <main class="main">
            <header class="topbar">
                <div class="d-flex align-items-center gap-3">
                    <!-- Botón hamburger (visible solo en móvil) -->
                    <button class="btn-hamburger" type="button" onclick="abrirMenu()" aria-label="Abrir menú">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <h1><%: Page.Title %></h1>
                        <div class="fecha"><%: System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(DateTime.Today.ToString("dddd d 'de' MMMM 'de' yyyy")) %></div>
                    </div>
                </div>
                <div class="chip"><span class="av">R</span>Recepción</div>
            </header>
            <div class="content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </main>
    </div>

    <!-- ===== Contenedor de toasts ===== -->
    <div class="toast-host" id="toastHost"></div>

</form>

<!-- Chart.js (cargado antes del placeholder de scripts de las páginas) -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

<!-- Bootstrap JS (para modales de Bootstrap si se usan) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- ===== Script de toasts y menú hamburger ===== -->
<script>
    /* ---- Menú lateral en móvil ---- */
    function abrirMenu() {
        document.getElementById('sidebar').classList.add('abierta');
        document.getElementById('sidebarOverlay').classList.add('visible');
        document.body.style.overflow = 'hidden';
    }
    function cerrarMenu() {
        document.getElementById('sidebar').classList.remove('abierta');
        document.getElementById('sidebarOverlay').classList.remove('visible');
        document.body.style.overflow = '';
    }
    /* Cerrar con Escape */
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') cerrarMenu();
    });

    /* ---- Sistema de toasts ---- */
    /**
     * Muestra un toast flotante.
     * @param {string} mensaje - Texto a mostrar.
     * @param {boolean} ok     - true=éxito (verde), false=error (rojo).
     * @param {number}  ms     - Milisegundos hasta auto-cierre (default 4500).
     */
    function mostrarToast(mensaje, ok, ms) {
        ms = ms || 4500;
        var host  = document.getElementById('toastHost');
        var toast = document.createElement('div');
        toast.className = 'toast-aurora ' + (ok ? 'ok' : 'err');
        toast.innerHTML =
            '<div class="toast-ico"><i class="bi bi-' + (ok ? 'check-circle' : 'exclamation-triangle') + '"></i></div>' +
            '<div class="toast-body">' + escHtml(mensaje) + '</div>' +
            '<button class="toast-close" onclick="cerrarToast(this.parentElement)" aria-label="Cerrar">&times;</button>';
        host.appendChild(toast);
        /* Auto-cierre */
        setTimeout(function () { cerrarToast(toast); }, ms);
    }

    function cerrarToast(el) {
        if (!el || !el.parentElement) return;
        el.classList.add('saliendo');
        setTimeout(function () { if (el.parentElement) el.parentElement.removeChild(el); }, 230);
    }

    function escHtml(s) {
        return String(s)
            .replace(/&/g,'&amp;').replace(/</g,'&lt;')
            .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
</script>

<!-- Placeholder para scripts específicos de cada página -->
<asp:ContentPlaceHolder ID="Scripts" runat="server" />
</body>
</html>
